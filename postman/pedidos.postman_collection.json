{
  "info": {
    "name": "API de Gerenciamento de Pedidos",
    "description": "Execute em ordem. Os cinco primeiros itens são os cenários obrigatórios de evidência.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "pedido_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Criação válida",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/pedidos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cliente\": \"Carlos Silva\",\n  \"tipo\": \"entrega\",\n  \"valor\": 350,\n  \"prioridade\": \"normal\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('Resposta JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.test('Pedido criado', () => { const p = pm.response.json(); pm.expect(p.cliente).to.eql('Carlos Silva'); pm.expect(p.status).to.eql('recebido'); pm.expect(p.id).to.be.a('number'); pm.collectionVariables.set('pedido_id', p.id); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Validação",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/pedidos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cliente\": \"   \",\n  \"tipo\": \"entrega\",\n  \"valor\": 350,\n  \"prioridade\": \"normal\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test('Resposta JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.test('Mensagem explicativa', () => pm.expect(pm.response.json().erro).to.be.a('string')); "
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Listagem",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/pedidos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Resposta JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.test('Contém o pedido criado', () => pm.expect(pm.response.json().some(p => p.id === Number(pm.collectionVariables.get('pedido_id')))).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Consulta inexistente",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/pedidos/9007199254740991"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404', () => pm.response.to.have.status(404));",
              "pm.test('Resposta JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.test('Pedido não encontrado', () => pm.expect(pm.response.json().erro).to.eql('Pedido não encontrado.'));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Atualização válida",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
